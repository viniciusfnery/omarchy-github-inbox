{
    "schemaVersion": 1,
    "id": "viniciusfnery.github-inbox",
    "name": "GitHub Inbox",
    "version": "0.0.4",
    "author": "Vinicius Nery",
    "license": "MIT",
    "description": "Your GitHub inbox in the bar: open PRs, review requests, assigned issues, mentions with read-state, notifications, and recent closures.",
    "kinds": [
        "bar-widget"
    ],
    "activation": "on-demand",
    "entryPoints": {
        "barWidget": "Panel.qml"
    },
    "barWidget": {
        "displayName": "GitHub Inbox",
        "description": "A bar chip with your open PR/review/issue count; the panel lists pull requests, review requests, issues, notifications (dismiss with d, right-click, or open to dismiss, with undo), mentions with unread dots, and recently closed items: org-filterable, fuzzy-searchable, fully keyboard-driven. Settings (s) hide orgs or repos, set a focus mode that narrows the inbox, chip, and alerts to chosen orgs and repos, and turn on desktop notifications.",
        "category": "Development",
        "defaultSection": "right",
        "aliases": [
            "github-inbox"
        ],
        "allowMultiple": false,
        "defaults": {
            "refreshIntervalSec": 300,
            "mentionLimit": 30,
            "closedDays": 30,
            "closedLimit": 5,
            "desktopNotifications": false,
            "focusMode": false,
            "hidden": [],
            "focus": []
        },
        "schema": [
            {
                "key": "refreshIntervalSec",
                "type": "integer",
                "label": "Refresh interval (seconds)",
                "min": 60,
                "max": 3600,
                "step": 60,
                "defaultValue": 300
            },
            {
                "key": "mentionLimit",
                "type": "integer",
                "label": "Mentions to track",
                "min": 5,
                "max": 50,
                "step": 5,
                "defaultValue": 30
            },
            {
                "key": "closedDays",
                "type": "integer",
                "label": "Recently-closed window (days)",
                "min": 7,
                "max": 90,
                "step": 1,
                "defaultValue": 30
            },
            {
                "key": "closedLimit",
                "type": "integer",
                "label": "Recently-closed rows per tab",
                "min": 1,
                "max": 20,
                "step": 1,
                "defaultValue": 5
            },
            {
                "key": "desktopNotifications",
                "type": "boolean",
                "label": "Desktop notifications",
                "description": "Pop up new GitHub notifications and mentions on the desktop.",
                "defaultValue": false
            },
            {
                "key": "focusMode",
                "type": "boolean",
                "label": "Focus mode",
                "description": "Only orgs and repos targeted in the panel's settings (press s) show, count, and notify.",
                "defaultValue": false
            }
        ]
    }
}
